# SSP sensor drivers and commons configuration
#
menu "SSP Sensor Common"

config IIO_SSP_SENSORS_COMMONS
	tristate "Commons for all SSP Sensor IIO drivers"
	depends on IIO_SSP_SENSORHUB
	select IIO_BUFFER
	select IIO_KFIFO_BUF
	help
	  Say yes here to build commons for SSP sensors.
	  To compile this as a module, choose M here: the module
	  will be called ssp_iio.

config IIO_SSP_SENSORHUB
	tristate "Samsung Sensorhub driver"
	depends on SPI
	select MFD_CORE
	help
	  SSP driver for sensorhub.
	  If you say yes here you get ssp support for sensorhub.
	  To compile this driver as a module, choose M here: the
	  module will be called sensorhub.

config IIO_SSP_SENSORHUB_BCM4773
	bool "Sensorhub behind a Broadcom BCM4773 (Galaxy S6)"
	depends on IIO_SSP_SENSORHUB && OF
	depends on BCM4773=y || BCM4773=IIO_SSP_SENSORHUB
	help
	  Say yes here for the Galaxy S6 and S6 edge, whose sensor hub
	  firmware runs on the BCM4773 GNSS chip and talks to the AP through
	  the BCM4773 bridge. The hub starts once userspace (lhd) has loaded
	  the chip's firmware.

config IIO_SSP_HUB_SENSORS
	tristate "SSP magnetometer, pressure, light, proximity and motion sensors"
	depends on IIO_SSP_SENSORHUB
	select IIO_BUFFER
	select IIO_KFIFO_BUF
	help
	  Say yes here for IIO devices of the sensorhub's magnetometer,
	  pressure, light and proximity sensors, rotation vectors, step
	  counter, step detector and significant motion.
	  To compile this as a module, choose M here: the module
	  will be called ssp_hub_sensors.

endmenu
