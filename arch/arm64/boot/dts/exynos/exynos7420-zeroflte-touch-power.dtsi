// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy S6 (SM-G920F) touchscreen supplies
 *
 * The STM FTS touchscreen takes its I/O rail from S2MPS15 LDO15 and its
 * analog rail from S2MPB02 LDO17. Neither PMIC bus has a controller node
 * here, so both are bit-banged on their stock pins.
 */

/ {
	i2c-tsp-main-pmic {
		compatible = "i2c-gpio";
		sda-gpios = <&gpg3 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpg3 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmic@66 {
			compatible = "samsung,s2mps15-pmic";
			reg = <0x66>;
			/*
			 * The PMIC interrupt (active low, gpa3-7) carries the
			 * RTC alarm, so it is also the wakeup that ends a
			 * suspend for Android's alarms.
			 */
			interrupt-parent = <&gpa3>;
			interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&pmic_irq>;
			wakeup-source;

			regulators {
				/*
				 * CPU cluster rails, scaled by cpufreq-dt. The
				 * limits are the stock board's.
				 */
				vdd_atlas: BUCK2 {
					regulator-name = "vdd_atlas";
					regulator-min-microvolt = <500000>;
					regulator-max-microvolt = <1300000>;
					regulator-always-on;
					regulator-boot-on;
				};

				vdd_apollo: BUCK3 {
					regulator-name = "vdd_apollo";
					regulator-min-microvolt = <500000>;
					regulator-max-microvolt = <1200000>;
					regulator-always-on;
					regulator-boot-on;
				};

				tsp_io_ldo15: LDO15 {
					regulator-name = "tsp_io";
					regulator-min-microvolt = <1850000>;
					regulator-max-microvolt = <1850000>;
					regulator-always-on;
					regulator-boot-on;
				};

				/* WM1840 AVDD, DBVDD1-4, CPVDD1, SPKVDDL/R. */
				codec_1v8: LDO16 {
					regulator-name = "vcc_1.8v_codec";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				/* Haptic motor supply (3.10 VCC_MOTOR_3.0) */
				vcc_motor: LDO17 {
					regulator-name = "vcc_motor_3.0v";
					regulator-min-microvolt = <3000000>;
					regulator-max-microvolt = <3000000>;
				};

				/* Touch key core supply; the 3.10 driver enables it at probe. */
				touchkey_vdd_ldo21: LDO21 {
					regulator-name = "vtouch_3.3v";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
				};

				/*
				 * WM1840 DCVDD and CPVDD2. REG_ID != 0 parts keep
				 * L26CTRL at 0x4c; s2mps11 handles that swap.
				 */
				codec_1v2: LDO26 {
					regulator-name = "vdd_1.2v_codec";
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
				};

				/*
				 * GPU supply (3.10 vdd_g3d). 3.10 hands BUCK6 enable
				 * to the G3D power GPIO (gpb0-4) and clears the
				 * B6CTRL1 enable bits, so it reads "disabled" here
				 * while the GPU runs. always-on sets those bits and
				 * keeps the rail up; pd_g3d never powers off anyway.
				 * The limits are 3.10's (G3D_MAX_VOLT 1018750). The
				 * ramp is the slowest BUCK_RAMP1 setting, 6 mV/us,
				 * because nothing here programs that register.
				 */
				vdd_g3d: BUCK6 {
					regulator-name = "vdd_g3d";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <1018750>;
					regulator-ramp-delay = <6000>;
					regulator-always-on;
					regulator-boot-on;
				};
			};
		};
	};

	/*
	 * S2MPB02: on 3.10 it sits on hsi2c@14E60000, whose pins are
	 * gpd0-2 (SDA) and gpd0-3 (SCL). On gpg3-2/3 it never answered
	 * (chip-ID read -ENXIO), so the touchscreen had no AVDD.
	 */
	i2c-tsp-analog-pmic {
		compatible = "i2c-gpio";
		sda-gpios = <&gpd0 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpd0 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmic@59 {
			compatible = "samsung,s2mpb02";
			reg = <0x59>;

			regulators {
				tsp_avdd_ldo17: ldo17 {
					regulator-name = "tsp_avdd";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					regulator-always-on;
				};
			};
		};
	};
};
