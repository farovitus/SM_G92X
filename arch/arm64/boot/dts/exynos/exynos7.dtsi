		cmu_disp: clock-controller@13ad0000 {
			compatible = "samsung,exynos7-clock-disp";
			reg = <0x13ad0000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_top0 CLK_ACLK_DISP_400>,
				 <&clock_top0 CLK_SCLK_DECON_INT_ECLK>,
				 <&clock_top0 CLK_SCLK_DECON_VCLK>;
			clock-names = "fin_pll", "aclk_disp_400",
				      "sclk_decon_int_eclk", "sclk_decon_vclk";
			status = "disabled";
		};

		cmu_g3d: clock-controller@14aa0000 {
			compatible = "samsung,exynos7-clock-g3d";
			reg = <0x14aa0000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>;
			clock-names = "fin_pll";
			status = "disabled";
		};

		serial_0: serial@13630000 {
			compatible = "samsung,exynos4210-uart";
			reg = <0x13630000 0x100>;
			interrupts = <GIC_SPI 440 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clock_peric0 PCLK_UART0>,
				 <&clock_peric0 SCLK_UART0>;
