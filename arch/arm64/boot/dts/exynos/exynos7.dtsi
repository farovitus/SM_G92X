#include <dt-bindings/clock/exynos7-clk.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	compatible = "samsung,exynos7";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		pinctrl0 = &pinctrl_alive;
		pinctrl1 = &pinctrl_bus0;
		pinctrl2 = &pinctrl_nfc;
		pinctrl3 = &pinctrl_touch;
		pinctrl4 = &pinctrl_ff;
		pinctrl5 = &pinctrl_ese;
		pinctrl6 = &pinctrl_fsys0;
		pinctrl7 = &pinctrl_fsys1;
		pinctrl8 = &pinctrl_bus1;
		pinctrl9 = &pinctrl_aud;
		tmuctrl0 = &tmuctrl_0;
	};

	arm-a53-pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu_apollo0>, <&cpu_apollo1>,
				     <&cpu_apollo2>, <&cpu_apollo3>;
	};

	arm-a57-pmu {
		compatible = "arm,cortex-a57-pmu";
		interrupts = <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu_atlas0>, <&cpu_atlas1>,
				     <&cpu_atlas2>, <&cpu_atlas3>;
	};

	fin_pll: clock {
		/* XXTI */
		compatible = "fixed-clock";
		clock-output-names = "fin_pll";
		#clock-cells = <0>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * Core power-down (C2) through PSCI 0.1 CPU_SUSPEND. The
		 * parameter asks for a power-down state, so the kernel saves
		 * the core's context; the PMU notifier in exynos-pmu clears
		 * the core's LOCAL_PWR_CFG for it. Residencies are the stock
		 * kernel's.
		 */
		idle-states {
			entry-method = "psci";

			CPU_C2_A57: cpu-c2-a57 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				entry-latency-us = <30>;
				exit-latency-us = <70>;
				min-residency-us = <2000>;
			};

			CPU_C2_A53: cpu-c2-a53 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				entry-latency-us = <30>;
				exit-latency-us = <70>;
				min-residency-us = <750>;
			};
		};

		/*
		 * Two clusters. Without the map and the per-MHz capacities the
		 * scheduler treats the eight cores as equal one-core clusters.
		 * The A53's efficiency, 677 per MHz to the A57's 1000, is the
		 * CoreMark value measured on a G920F (nk7420 calibration). With
		 * the top OPPs, 1.5 GHz on the A53s and 1.8 GHz on the A57s, it
		 * gives capacities of 578 and 1024.
		 */
		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu_atlas0>; };
				core1 { cpu = <&cpu_atlas1>; };
				core2 { cpu = <&cpu_atlas2>; };
				core3 { cpu = <&cpu_atlas3>; };
			};

			cluster1 {
				core0 { cpu = <&cpu_apollo0>; };
				core1 { cpu = <&cpu_apollo1>; };
				core2 { cpu = <&cpu_apollo2>; };
				core3 { cpu = <&cpu_apollo3>; };
			};
		};

		/*
		 * Linux makes the boot CPU, the first A53 (MPIDR 0x100), CPU 0 and
		 * numbers the others in node order. Listing the A57s first gives
		 * A57 = CPUs 1-4 and A53 = CPUs 0 and 5-7, the numbering the
		 * cpufreq, memlat and power work on this branch was measured with.
		 */
		cpu_atlas0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A57>;
			capacity-dmips-mhz = <1000>;
			clocks = <&clock_atlas CLK_SCLK_ATLAS>;
			operating-points-v2 = <&cpu_atlas_opp_table>;
			#cooling-cells = <2>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&atlas_l2>;
		};

		cpu_atlas1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x1>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A57>;
			capacity-dmips-mhz = <1000>;
			clocks = <&clock_atlas CLK_SCLK_ATLAS>;
			operating-points-v2 = <&cpu_atlas_opp_table>;
			#cooling-cells = <2>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&atlas_l2>;
		};

		cpu_atlas2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x2>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A57>;
			capacity-dmips-mhz = <1000>;
			clocks = <&clock_atlas CLK_SCLK_ATLAS>;
			operating-points-v2 = <&cpu_atlas_opp_table>;
			#cooling-cells = <2>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&atlas_l2>;
		};

		cpu_atlas3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x3>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A57>;
			capacity-dmips-mhz = <1000>;
			clocks = <&clock_atlas CLK_SCLK_ATLAS>;
			operating-points-v2 = <&cpu_atlas_opp_table>;
			#cooling-cells = <2>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&atlas_l2>;
		};

		cpu_apollo0: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A53>;
			capacity-dmips-mhz = <677>;
			clocks = <&clock_apollo CLK_SCLK_APOLLO>;
			operating-points-v2 = <&cpu_apollo_opp_table>;
			#cooling-cells = <2>;
		};

		cpu_apollo1: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A53>;
			capacity-dmips-mhz = <677>;
			clocks = <&clock_apollo CLK_SCLK_APOLLO>;
			operating-points-v2 = <&cpu_apollo_opp_table>;
			#cooling-cells = <2>;
		};

		cpu_apollo2: cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A53>;
			capacity-dmips-mhz = <677>;
			clocks = <&clock_apollo CLK_SCLK_APOLLO>;
			operating-points-v2 = <&cpu_apollo_opp_table>;
			#cooling-cells = <2>;
		};

		cpu_apollo3: cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_C2_A53>;
			capacity-dmips-mhz = <677>;
			clocks = <&clock_apollo CLK_SCLK_APOLLO>;
			operating-points-v2 = <&cpu_apollo_opp_table>;
			#cooling-cells = <2>;
		};

		atlas_l2: l2-cache0 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x200000>;
			cache-line-size = <64>;
			cache-sets = <2048>;
		};
	};

	/*
	 * Cluster DVFS: the stock enabled ranges with the stock fallback
	 * voltages, which are at or above every fused ASV group. Atlas stops
	 * at 1.8 GHz while the PMIC's SRAM-rail tracking is left as S-Boot
	 * programmed it; above 1.125 V it must be switched.
	 *
	 * opp-microwatt is the energy model: per-core power measured on a
	 * G920F (calibration run 20260809T115944Z), plus a quarter of the
	 * measured shared-cluster power, since the energy model has no
	 * cluster term. It was measured at that phone's fused ASV voltages,
	 * so absolute power here is somewhat low; the ratio between the
	 * clusters, which energy-aware scheduling uses, is what matters.
	 */
	cpu_atlas_opp_table: opp-table-atlas {
		compatible = "operating-points-v2";
		opp-shared;

		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <825000>;
			opp-microwatt = <261750>;
			clock-latency-ns = <500000>;
		};

		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <850000>;
			opp-microwatt = <304500>;
			clock-latency-ns = <500000>;
		};

		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <875000>;
			opp-microwatt = <359500>;
			clock-latency-ns = <500000>;
		};

		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <900000>;
			opp-microwatt = <428250>;
			clock-latency-ns = <500000>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <925000>;
			opp-microwatt = <493250>;
			clock-latency-ns = <500000>;
		};

		opp-1300000000 {
			opp-hz = /bits/ 64 <1300000000>;
			opp-microvolt = <950000>;
			opp-microwatt = <563250>;
			clock-latency-ns = <500000>;
		};

		opp-1400000000 {
			opp-hz = /bits/ 64 <1400000000>;
			opp-microvolt = <981250>;
			opp-microwatt = <654000>;
			clock-latency-ns = <500000>;
		};

		opp-1500000000 {
			opp-hz = /bits/ 64 <1500000000>;
			opp-microvolt = <1012500>;
			opp-microwatt = <737000>;
			clock-latency-ns = <500000>;
		};

		opp-1600000000 {
			opp-hz = /bits/ 64 <1600000000>;
			opp-microvolt = <1043750>;
			opp-microwatt = <855000>;
			clock-latency-ns = <500000>;
		};

		opp-1704000000 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <1081250>;
			opp-microwatt = <989750>;
			clock-latency-ns = <500000>;
		};

		opp-1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1118750>;
			opp-microwatt = <1156750>;
			clock-latency-ns = <500000>;
		};
	};

	cpu_apollo_opp_table: opp-table-apollo {
		compatible = "operating-points-v2";
		opp-shared;

		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <675000>;
			opp-microwatt = <25000>;
			clock-latency-ns = <500000>;
		};

		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <712500>;
			opp-microwatt = <35000>;
			clock-latency-ns = <500000>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <750000>;
			opp-microwatt = <43000>;
			clock-latency-ns = <500000>;
		};

		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <787500>;
			opp-microwatt = <54000>;
			clock-latency-ns = <500000>;
		};

		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <825000>;
			opp-microwatt = <66000>;
			clock-latency-ns = <500000>;
		};

		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <862500>;
			opp-microwatt = <81000>;
			clock-latency-ns = <500000>;
		};

		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <900000>;
			opp-microwatt = <96000>;
			clock-latency-ns = <500000>;
		};

		opp-1104000000 {
			opp-hz = /bits/ 64 <1104000000>;
			opp-microvolt = <943750>;
			opp-microwatt = <117000>;
			clock-latency-ns = <500000>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <981250>;
			opp-microwatt = <140250>;
			clock-latency-ns = <500000>;
		};

		opp-1296000000 {
			opp-hz = /bits/ 64 <1296000000>;
			opp-microvolt = <1018750>;
			opp-microwatt = <166250>;
			clock-latency-ns = <500000>;
		};

		opp-1400000000 {
			opp-hz = /bits/ 64 <1400000000>;
			opp-microvolt = <1068750>;
			opp-microwatt = <200250>;
			clock-latency-ns = <500000>;
		};

		opp-1500000000 {
			opp-hz = /bits/ 64 <1500000000>;
			opp-microvolt = <1118750>;
			opp-microwatt = <237250>;
			clock-latency-ns = <500000>;
		};
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
	};

	soc: soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0 0x18000000>;

		chipid@10000000 {
			compatible = "samsung,exynos4210-chipid";
			reg = <0x10000000 0x100>;
		};

		gic: interrupt-controller@11001000 {
			compatible = "arm,gic-400";
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-controller;
			reg = <0x11001000 0x1000>,
			      <0x11002000 0x2000>,
			      <0x11004000 0x2000>,
			      <0x11006000 0x2000>;
		};

		pdma0: dma-controller@10e10000 {
			compatible = "arm,pl330", "arm,primecell";
			reg = <0x10e10000 0x1000>;
			interrupts = <GIC_SPI 225 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clock_fsys0 ACLK_PDMA0>;
			clock-names = "apb_pclk";
			#dma-cells = <1>;
		};

		pdma1: dma-controller@10eb0000 {
			compatible = "arm,pl330", "arm,primecell";
			reg = <0x10eb0000 0x1000>;
			interrupts = <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clock_fsys0 ACLK_PDMA1>;
			clock-names = "apb_pclk";
			#dma-cells = <1>;
		};

		/*
		 * LPASS routes the DMA and I2S interrupts to the CPU and holds
		 * their resets. The UART at 0x11460000 (serial_4) is in the
		 * same block but stays outside this node; the exynos7 variant
		 * of the driver leaves it alone. The second reg is the AUD
		 * SysMMU, which the driver sets to bypass. The clocks keep the
		 * SysMMU and the bridge to the top bus, the ADMA's path out,
		 * running while LPASS is up.
		 */
		lpass: audio-subsystem@11400000 {
			compatible = "samsung,exynos7-lpass";
			reg = <0x11400000 0x100>, <0x114e0000 0x100>;
			clocks = <&cmu_aud PCLK_SMMU_AUD>,
				 <&cmu_aud ACLK_SMMU_AUD>,
				 <&cmu_aud ACLK_ACEL_LH_ASYNC_SI_TOP>;
			clock-names = "smmu_pclk", "smmu_aclk", "async_aclk";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
			status = "disabled";

			adma: dma-controller@11420000 {
				compatible = "arm,pl330", "arm,primecell";
				reg = <0x11420000 0x1000>;
				interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&cmu_aud ACLK_ADMA>;
				clock-names = "apb_pclk";
				#dma-cells = <1>;
			};

			i2s0: i2s@11440000 {
				compatible = "samsung,exynos7-i2s";
				reg = <0x11440000 0x100>;
				interrupts = <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>;
				dmas = <&adma 0>, <&adma 2>;
				dma-names = "tx", "rx";
				clocks = <&cmu_aud PCLK_I2S>, <&cmu_aud SCLK_I2S>,
					 <&cmu_aud SCLK_I2S>;
				clock-names = "iis", "i2s_opclk0", "i2s_opclk1";
				#sound-dai-cells = <1>;
				status = "disabled";
			};
		};

		clock_atlas: clock-controller@11800000 {
			compatible = "samsung,exynos7-clock-atlas";
			reg = <0x11800000 0x2000>;
			#clock-cells = <1>;
			clocks = <&fin_pll>;
			clock-names = "fin_pll";
		};

		clock_apollo: clock-controller@11900000 {
			compatible = "samsung,exynos7-clock-apollo";
			reg = <0x11900000 0x2000>;
			#clock-cells = <1>;
			clocks = <&fin_pll>;
			clock-names = "fin_pll";
		};

		clock_topc: clock-controller@10570000 {
			compatible = "samsung,exynos7-clock-topc";
			reg = <0x10570000 0x10000>;
			#clock-cells = <1>;
		};

		clock_top0: clock-controller@105d0000 {
			compatible = "samsung,exynos7-clock-top0";
			reg = <0x105d0000 0xb000>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_topc DOUT_SCLK_BUS0_PLL>,
				 <&clock_topc DOUT_SCLK_BUS1_PLL>,
				 <&clock_topc DOUT_SCLK_CC_PLL>,
				 <&clock_topc DOUT_SCLK_MFC_PLL>,
				 <&clock_topc DOUT_SCLK_AUD_PLL>;
			clock-names = "fin_pll", "dout_sclk_bus0_pll",
				      "dout_sclk_bus1_pll", "dout_sclk_cc_pll",
				      "dout_sclk_mfc_pll", "dout_sclk_aud_pll";
		};

		clock_top1: clock-controller@105e0000 {
			compatible = "samsung,exynos7-clock-top1";
			reg = <0x105e0000 0xb000>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_topc DOUT_SCLK_BUS0_PLL>,
				 <&clock_topc DOUT_SCLK_BUS1_PLL>,
				 <&clock_topc DOUT_SCLK_CC_PLL>,
				 <&clock_topc DOUT_SCLK_MFC_PLL>;
			clock-names = "fin_pll", "dout_sclk_bus0_pll",
				      "dout_sclk_bus1_pll", "dout_sclk_cc_pll",
				      "dout_sclk_mfc_pll";
		};

		clock_ccore: clock-controller@105b0000 {
			compatible = "samsung,exynos7-clock-ccore";
			reg = <0x105b0000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_topc DOUT_ACLK_CCORE_133>;
			clock-names = "fin_pll", "dout_aclk_ccore_133";
		};

		clock_peric0: clock-controller@13610000 {
			compatible = "samsung,exynos7-clock-peric0";
			reg = <0x13610000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_top0 DOUT_ACLK_PERIC0>,
				 <&clock_top0 CLK_SCLK_UART0>;
			clock-names = "fin_pll", "dout_aclk_peric0_66",
				      "sclk_uart0";
		};

		clock_peric1: clock-controller@14c80000 {
			compatible = "samsung,exynos7-clock-peric1";
			reg = <0x14c80000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>,
				 <&clock_top0 DOUT_ACLK_PERIC1>,
				 <&clock_top0 CLK_SCLK_UART1>,
				 <&clock_top0 CLK_SCLK_UART2>,
				 <&clock_top0 CLK_SCLK_UART3>,
				 <&clock_top0 CLK_SCLK_SPI0>,
				 <&clock_top0 CLK_SCLK_SPI1>,
				 <&clock_top0 CLK_SCLK_SPI2>,
				 <&clock_top0 CLK_SCLK_SPI3>,
				 <&clock_top0 CLK_SCLK_SPI4>,
				 <&clock_top0 CLK_SCLK_I2S1>,
				 <&clock_top0 CLK_SCLK_PCM1>,
				 <&clock_top0 CLK_SCLK_SPDIF>;
			clock-names = "fin_pll",
				      "dout_aclk_peric1_66",
				      "sclk_uart1",
				      "sclk_uart2",
				      "sclk_uart3",
				      "sclk_spi0",
				      "sclk_spi1",
				      "sclk_spi2",
				      "sclk_spi3",
				      "sclk_spi4",
				      "sclk_i2s1",
				      "sclk_pcm1",
				      "sclk_spdif";
		};

		clock_peris: clock-controller@10040000 {
			compatible = "samsung,exynos7-clock-peris";
			reg = <0x10040000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_topc DOUT_ACLK_PERIS>;
			clock-names = "fin_pll", "dout_aclk_peris_66";
		};

		clock_fsys0: clock-controller@10e90000 {
			compatible = "samsung,exynos7-clock-fsys0";
			reg = <0x10e90000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_top1 DOUT_ACLK_FSYS0_200>,
				 <&clock_top1 DOUT_SCLK_MMC2>;
			clock-names = "fin_pll", "dout_aclk_fsys0_200",
				      "dout_sclk_mmc2";
		};

		/*
		 * MIPI-LLI to the modem CP. Register windows, interrupts and
		 * clocks from the stock tw70-stock exynos7420.dtsi node; the
		 * M-PHY (stock "mphy" child) is folded into "phy" and "pma".
		 * The combo PHY PMA at 0x10ed0000 is shared with PCIe channel 0,
		 * which this tree does not use. Boards add the IPC carve-out
		 * (memory-region) and the M-PHY settings.
		 */
		mipi_lli: mipi-lli@10f24000 {
			compatible = "samsung,exynos7420-mipi-lli";
			reg = <0x10f24000 0x4000>,
			      <0x10f34000 0x4000>,
			      <0x10050000 0x2000>,
			      <0x10f20000 0x4000>,
			      <0x10ed0000 0x200>;
			reg-names = "lli", "remote", "sysreg", "phy", "pma";
			interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "lli", "sig";
			samsung,pmu-syscon = <&pmu_system_controller 0x724>;
			clocks = <&clock_fsys0 ACLK_XIU_MODEMX>,
				 <&clock_fsys0 ACLK_COMBO_PHY_MODEM_PCS_PCLK>,
				 <&clock_fsys0 SCLK_PHY_FSYS0>,
				 <&clock_fsys0 SCLK_COMBO_PHY_MODEM_26M>,
				 <&clock_fsys0 PCLK_ASYNC_COMBO_PHY_MODEM>,
				 <&clock_fsys0 ACLK_XIU_LLISFRX>,
				 <&clock_fsys0 ACLK_AXIUS_LLI_BE>,
				 <&clock_fsys0 ACLK_AXIUS_LLI_LL>,
				 <&clock_fsys0 ACLK_AXIUS_LLISFRX_LLILL>,
				 <&clock_fsys0 ACLK_AXIUS_LLISFRX_LLIBE>,
				 <&clock_fsys0 ACLK_LLI_SVC_LOC>,
				 <&clock_fsys0 ACLK_LLI_SVC_REM>,
				 <&clock_fsys0 ACLK_LLI_LL_INIT>,
				 <&clock_fsys0 ACLK_LLI_BE_INIT>,
				 <&clock_fsys0 ACLK_LLI_LL_TARG>,
				 <&clock_fsys0 ACLK_LLI_BE_TARG>,
				 <&clock_fsys0 PHYCLK_LLI_TX0_SYMBOL_USER>,
				 <&clock_fsys0 PHYCLK_LLI_RX0_SYMBOL_USER>;
			clock-names = "aclk_xiu_modemx",
				      "aclk_combo_phy_modem_pcs_pclk",
				      "sclk_phy_fsys0",
				      "sclk_combo_phy_modem_26m",
				      "pclk_async_combo_phy_modem",
				      "aclk_xiu_llisfrx",
				      "aclk_axius_lli_be",
				      "aclk_axius_lli_ll",
				      "aclk_axius_llisfrx_llill",
				      "aclk_axius_llisfrx_llibe",
				      "aclk_lli_svc_loc",
				      "aclk_lli_svc_rem",
				      "aclk_lli_ll_init",
				      "aclk_lli_be_init",
				      "aclk_lli_ll_targ",
				      "aclk_lli_be_targ",
				      "user_phyclk_lli_tx0_symbol",
				      "user_phyclk_lli_rx0_symbol";
			/*
			 * Stock USERMUX clocks: select the PHY-side symbol clocks.
			 * mout_sclk_phy_fsys0_user keeps the bootloader setting,
			 * because its parent sits in CMU_TOP1, which boards may
			 * leave unregistered.
			 */
			assigned-clocks = <&clock_fsys0 MOUT_PHYCLK_LLI_TX0_USER>,
					  <&clock_fsys0 MOUT_PHYCLK_LLI_RX0_USER>;
			assigned-clock-parents = <&clock_fsys0 PHYCLK_LLI_TX0>,
						 <&clock_fsys0 PHYCLK_LLI_RX0>;
			status = "disabled";
		};

		clock_fsys1: clock-controller@156e0000 {
			compatible = "samsung,exynos7-clock-fsys1";
			reg = <0x156e0000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_top1 DOUT_ACLK_FSYS1_200>,
				 <&clock_top1 DOUT_SCLK_MMC0>,
				 <&clock_top1 DOUT_SCLK_MMC1>,
				 <&clock_top1 DOUT_SCLK_UFSUNIPRO20>,
				 <&clock_top1 DOUT_SCLK_PHY_FSYS1>,
				 <&clock_top1 DOUT_SCLK_PHY_FSYS1_26M>;
			clock-names = "fin_pll", "dout_aclk_fsys1_200",
				      "dout_sclk_mmc0", "dout_sclk_mmc1",
				      "dout_sclk_ufsunipro20", "dout_sclk_phy_fsys1",
				      "dout_sclk_phy_fsys1_26m";
		};

		cmu_aud: clock-controller@114c0000 {
			compatible = "samsung,exynos7-clock-aud";
			reg = <0x114c0000 0xd00>;
			#clock-cells = <1>;
			clocks = <&fin_pll>, <&clock_topc FOUT_AUD_PLL>;
