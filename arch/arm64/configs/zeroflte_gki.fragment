# Samsung Galaxy S6 SM-G920F (zeroflte), Exynos 7420.
# Applied on top of gki_defconfig. Bring-up drivers are built in, so the
# board boots without a vendor module set.

# Core SoC
CONFIG_ARCH_EXYNOS=y
CONFIG_EXYNOS_ARM64_COMMON_CLK=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PINCTRL_EXYNOS_ARM64=y
CONFIG_EXYNOS_PMU=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_EXYNOS_PM_DOMAINS=y
CONFIG_CLKSRC_EXYNOS_MCT=y
CONFIG_EXYNOS_IOMMU=y
CONFIG_PL330_DMA=y
CONFIG_PWM_SAMSUNG=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_EXYNOS_THERMAL=y
# Cooling-device names the ROM's thermal HAL requires (placeholders).
CONFIG_SEC_COOLING_COMPAT=y
CONFIG_EXYNOS_ADC=y
CONFIG_RTC_DRV_S3C=y
# The S2MPS15 RTC keeps time and raises the alarms that wake the phone.
CONFIG_RTC_DRV_S5M=y
# S-Boot's restart targets (recovery, download) through PMU INFORM3.
CONFIG_SYSCON_REBOOT_MODE=y
# Power off by dropping PS_HOLD (syscon-poweroff node in the SoC DT).
CONFIG_POWER_RESET_SYSCON_POWEROFF=y

# Cluster DVFS: cpufreq-dt on the DT OPP tables, schedutil (GKI default).
CONFIG_CPUFREQ_DT=y

# Console
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Storage
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y

# PMIC, charger, fuel gauge
CONFIG_I2C_EXYNOS5=y
CONFIG_I2C_GPIO=y
CONFIG_MFD_SEC_CORE=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_REGULATOR_S2MPB02=y
CONFIG_MFD_MAX77843=y
CONFIG_CHARGER_MAX77843=y
CONFIG_FUEL_GAUGE_MAX77843=y
# Haptic motor (LRA) on the MAX77843, driven by PWM timer 1.
CONFIG_INPUT_MAX77693_HAPTIC=y
# MUIC: cable detection and the micro-USB data switch (adb).
CONFIG_EXTCON_MAX77843=y
# "battery" and "ac", the names the ROM's thermal and health HALs use.
CONFIG_BATTERY_SAMSUNG_COMPAT=y

# Display
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS7_DECON=y
# DECON takes its connector and fixed mode from the DPI display-timings;
# S-Boot has already brought up DSI and the panel.
CONFIG_DRM_EXYNOS_DPI=y
CONFIG_DRM_SIMPLEDRM=y
# Mali-T760 MP8 for Mesa's panfrost driver. The Samsung Mali blobs in the
# ROM need the 3.10 kbase driver and cannot run on this kernel.
CONFIG_DRM_PANFROST=y
# /dev/dma_heap/system, the cached allocator minigbm gralloc4 and the
# AIDL allocator use for buffers that are not scanned out.
CONFIG_DMABUF_HEAPS_SYSTEM=y

# Input
CONFIG_TOUCHSCREEN_STMFTS=y
CONFIG_KEYBOARD_CYPRESS_MBR_TOUCHKEY=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# USB
CONFIG_USB_DWC3=y
CONFIG_PHY_EXYNOS5_USBDRD=y
# The ROM builds its gadget through configfs (adb, MTP and PTP over
# FunctionFS) and gets USB state uevents from android_usb. The legacy
# g_ffs gadget (USB_FUNCTIONFS_GENERIC) must stay out: it would claim the
# UDC first. GKI leaves it off, so nothing is set here.

# mDNIe/panel nodes Lineage's LiveDisplay HAL needs before it registers.
CONFIG_SAMSUNG_MDNIE_COMPAT=y

# Trustonic t-base for McDaemon, which Samsung's keymaster HAL needs.
CONFIG_TRUSTONIC_MOBICORE=y

# PCIe (BCM4358 Wi-Fi)
CONFIG_PCI_EXYNOS7420=y
# Wi-Fi: mainline brcmfmac drives the BCM4358 over PCIe, with the
# firmware and NVRAM from the ROM. Built in, so the driver always matches
# the Image (cfg80211 built in needs rfkill built in too).
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
# The built-in driver requests its firmware while probing, before /vendor
# is mounted. Let each request wait for ueventd, which serves it from
# /vendor/firmware once it runs, instead of failing at once.
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
CONFIG_BRCMFMAC_PCIE=y
# CONFIG_BRCMFMAC_USB is not set

# Initramfs decompressors: xz, which the Lineage 20 ramdisk in BOOT uses
# because it is the smallest, and LZ4, the fastest, whose code zram and
# crypto already pull in. GKI's gzip and zstd unpackers are not needed,
# nor are XZ's branch filters for other architectures.
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_XZ_DEC_X86 is not set
# CONFIG_XZ_DEC_POWERPC is not set
# CONFIG_XZ_DEC_IA64 is not set
# CONFIG_XZ_DEC_SPARC is not set

# Bring-up: faster builds without LTO (kCFI does not need it).
CONFIG_LTO_NONE=y

# kheaders.ko packs the kernel headers for BPF tools with GNU tar options
# macOS tar lacks, and nothing on the phone reads them.
# CONFIG_IKHEADERS is not set

# gki_defconfig builds in support for every GKI vendor. Drop what the
# Exynos 7420 board can never use: other SoC families, firmware interfaces
# S-Boot does not provide (SCMI, SCPI, EFI; GPT parsing stays), and buses
# and hardware the phone lacks (NVMe, NVDIMM, EDAC, USB-C, SD/MMC, I3C,
# remote processors, HDMI CEC).
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_EFI is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_LIBNVDIMM is not set
# CONFIG_EDAC is not set
# CONFIG_TYPEC is not set
# CONFIG_MMC is not set
# CONFIG_I3C is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# Every module is built from this tree, so nothing attaches to GKI's
# vendor hooks.
# CONFIG_ANDROID_VENDOR_HOOKS is not set

# S-Boot enters the kernel at EL1, so KVM can never run.
# CONFIG_KVM is not set
# Nor can any other guest or hypervisor: drop Qualcomm's Gunyah, the vhost
# backends, vsock and virtio-fs.
# CONFIG_GUNYAH is not set
# CONFIG_VHOST_MENU is not set
# CONFIG_VSOCKETS is not set
# CONFIG_VIRTIO_FS is not set

# S-Boot's arguments follow this string (CMDLINE_EXTEND). GKI's defaults
# without the pKVM ones, plus what the port needs: S-Boot's display clocks
# and power domains stay on. No androidboot.selinux here: Android keeps
# the first one it finds, and S-Boot's enforcing must be that one.
# The kernel keeps the last loglevel, S-Boot's 4, so ignore_loglevel keeps
# every message in the RAM log. log_buf_len keeps the kernel's boot
# messages through Android's /dev/kmsg traffic, and dsh_autorecovery
# returns a test boot to TWRP after 150 s with them replayed into the log,
# unless userspace cancels it once the boot completes. The hardware
# watchdog runs from its probe (s3c2410_wdt.tmr_atboot). firmware_class.path
# lets drivers such as brcmfmac load firmware straight from /vendor/firmware.
CONFIG_CMDLINE="stack_depot_disable=on cgroup_disable=pressure kasan.stacktrace=off bootconfig clk_ignore_unused pd_ignore_unused deferred_probe_timeout=0 rodata=on loglevel=8 printk.devkmsg=on ignore_loglevel log_buf_len=4M dsh_autorecovery=150 s3c2410_wdt.tmr_atboot=1 firmware_class.path=/vendor/firmware"

# Size: the Image must fit the 28 MiB BOOT partition with the ROM ramdisk.
# The A57/A53 have no pointer authentication, so the PAC-to-SCS patching
# and its 3 MB of unwind tables can never be used; shadow call stacks stay,
# compiled in statically.
# CONFIG_UNWIND_PATCH_PAC_INTO_SCS is not set
# Keep only the codepages Android uses (UTF-8, and CP437/ISO-8859-1 for FAT).
# CONFIG_NLS_CODEPAGE_737 is not set
# CONFIG_NLS_CODEPAGE_775 is not set
# CONFIG_NLS_CODEPAGE_850 is not set
# CONFIG_NLS_CODEPAGE_852 is not set
# CONFIG_NLS_CODEPAGE_855 is not set
# CONFIG_NLS_CODEPAGE_857 is not set
# CONFIG_NLS_CODEPAGE_860 is not set
# CONFIG_NLS_CODEPAGE_861 is not set
# CONFIG_NLS_CODEPAGE_862 is not set
# CONFIG_NLS_CODEPAGE_863 is not set
# CONFIG_NLS_CODEPAGE_864 is not set
# CONFIG_NLS_CODEPAGE_865 is not set
# CONFIG_NLS_CODEPAGE_866 is not set
# CONFIG_NLS_CODEPAGE_869 is not set
# CONFIG_NLS_CODEPAGE_936 is not set
# CONFIG_NLS_CODEPAGE_950 is not set
# CONFIG_NLS_CODEPAGE_932 is not set
# CONFIG_NLS_CODEPAGE_949 is not set
# CONFIG_NLS_CODEPAGE_874 is not set
# CONFIG_NLS_ISO8859_8 is not set
# CONFIG_NLS_CODEPAGE_1250 is not set
# CONFIG_NLS_CODEPAGE_1251 is not set
# CONFIG_NLS_ISO8859_2 is not set
# CONFIG_NLS_ISO8859_3 is not set
# CONFIG_NLS_ISO8859_4 is not set
# CONFIG_NLS_ISO8859_5 is not set
# CONFIG_NLS_ISO8859_6 is not set
# CONFIG_NLS_ISO8859_7 is not set
# CONFIG_NLS_ISO8859_9 is not set
# CONFIG_NLS_ISO8859_13 is not set
# CONFIG_NLS_ISO8859_14 is not set
# CONFIG_NLS_ISO8859_15 is not set
# CONFIG_NLS_KOI8_R is not set
# CONFIG_NLS_KOI8_U is not set
# CONFIG_NLS_MAC_ROMAN is not set
# CONFIG_NLS_MAC_CELTIC is not set
# CONFIG_NLS_MAC_CENTEURO is not set
# CONFIG_NLS_MAC_CROATIAN is not set
# CONFIG_NLS_MAC_CYRILLIC is not set
# CONFIG_NLS_MAC_GAELIC is not set
# CONFIG_NLS_MAC_GREEK is not set
# CONFIG_NLS_MAC_ICELAND is not set
# CONFIG_NLS_MAC_INUIT is not set
# CONFIG_NLS_MAC_ROMANIAN is not set
# CONFIG_NLS_MAC_TURKISH is not set
# The A57/A53 have no MTE, so hardware-tag KASAN never enables itself;
# its hooks are dead code here.
# CONFIG_KASAN is not set
# CONFIG_ARM64_MTE is not set

# No VT, framebuffer console or DRM fbdev emulation, as in GKI: Android
# draws through KMS only. The fbdev client made the kernel's own modeset
# at about 1 s, which replaced S-Boot's splash with its black buffer
# (and fbcon's cursor) until the boot animation. Without it the
# command-mode panel keeps the splash until the composer's first commit.
# For an on-screen log during bring-up, set CONFIG_VT,
# CONFIG_DRM_FBDEV_EMULATION and CONFIG_FRAMEBUFFER_CONSOLE again and
# add console=tty0.
# CONFIG_VT is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# Room for the console: UBSAN's inline bounds checks cost about 1 MB.
# CONFIG_UBSAN is not set
CONFIG_LEDS_MAX77843=y
CONFIG_DRM_EXYNOS7420_DSIM_CMD=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA2=y

# Audio
# LPASS routes the ADMA and I2S interrupts to the CPU (exynos7 variant).
CONFIG_MFD_EXYNOS_LPASS=y
# SPI0's controller clock is in CMU_PERIC1, which hangs the bus: bit-bang it.
CONFIG_SPI_GPIO=y
# Galaxy S6 sensor hub: the BCM4773 GNSS chip runs the SSP hub firmware
# that lhd loads, on SPI1. The controller is built in, so the vendor
# modprobe list needs no change; spi-exynos-gpio stays a module only
# because that list still names it.
CONFIG_SPI_S3C64XX=y
CONFIG_SPI_EXYNOS_GPIO=m
CONFIG_BCM4773=m
CONFIG_IIO_SSP_SENSORHUB=m
CONFIG_IIO_SSP_SENSORHUB_BCM4773=y
CONFIG_IIO_SSP_SENSORS_COMMONS=m
CONFIG_IIO_SSP_HUB_SENSORS=m
# Cirrus WM1840 (CS47L85 family) codec core, its SPI bus and its MICVDD pump.
# Modules: the mainline CS47L85 route table alone is 4.5 MB, which built
# in pushes the Image past the 29 MB BOOT partition.
CONFIG_MFD_MADERA=m
CONFIG_MFD_MADERA_SPI=m
CONFIG_MFD_CS47L85=y
CONFIG_GPIO_MADERA=m
CONFIG_REGULATOR_ARIZONA_MICSUPP=m
CONFIG_SND_SOC_SAMSUNG=y
CONFIG_SND_SOC_SAMSUNG_ZERO_WM1840=m

# Root: KernelSU, built in, hooked through kprobes, the syscall
# tracepoint and its sys_call_table dispatcher (GKI mode).
CONFIG_KSU=y
# KernelSU finds sys_call_table, security_hook_heads and other data
# symbols through kallsyms, as on GKI.
CONFIG_KALLSYMS_ALL=y

# Bus DVFS: exynos-bus scales the display bus and its BUCK5 rail from
# the DECON's interconnect bandwidth request.
CONFIG_ARM_EXYNOS_BUS_DEVFREQ=y
CONFIG_INTERCONNECT_SAMSUNG=y
CONFIG_INTERCONNECT_EXYNOS=y

# DRAM (MIF) frequency switching through the BUS0 safe PLL.
CONFIG_EXYNOS7420_DMC=y

# Lockups end in a panic, so the board restarts (into recovery on a test
# boot) instead of hanging. The hard-lockup detector uses the buddy
# scheme (no perf NMI on this GIC-400 board).
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# A task stuck in D state for 60 s (a lock cycle that leaves the
# watchdog fed) panics too.
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60

# Shannon 333 modem: MIPI-LLI shared-memory IPC and the SS333 modem
# interface (umts_* nodes, rmnet0-7). The CP bootloader goes over the
# spi-gpio bus enabled above.
CONFIG_MIPI_LLI=y
CONFIG_SEC_MODEM_SS333=y

# Entropy: the secure-world TRNG seeds the CRNG before /init.
CONFIG_HW_RANDOM_EXYNOS7420_SWD=y

# Room in BOOT: drop what this phone cannot use. log_buf_len=4M in the
# cmdline reallocates the log buffer early, so the 128 KB static one (and
# its 450 KB of record tables) only has to cover the first lines.
CONFIG_LOG_BUF_SHIFT=12
# /data is ext4 (f2fs without the compress option is the alternative),
# zram uses lz4 and the ramdisk is xz: nothing reads or writes zstd.
# CONFIG_F2FS_FS_ZSTD is not set
# CONFIG_CRYPTO_ZSTD is not set
# Non-A/B, no dm devices: no snapshots, checkpoint or userspace snapshot
# daemon; no erofs images; no RAM, ublk or network-emulation test devices.
# CONFIG_DM_SNAPSHOT is not set
# CONFIG_DM_BOW is not set
# CONFIG_DM_USER is not set
# CONFIG_EROFS_FS is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_UBLK is not set
# CONFIG_NET_SCH_NETEM is not set
# No camera driver, and Android 13 has no USB webcam or webcam-gadget
# support configured here: the V4L2 and media stack has no user. GKI
# forces it, with other groups, through GKI_HACKS_TO_FIX for vendor
# modules built out of tree; every module here is built in this tree,
# so keep only the groups the board or Android uses: XFRM (Android's
# network tests), crypto engine, DRM helpers, regmap IRQ/MMIO, sound,
# UFS, pinctrl/GPIO, wireless extensions, USB PHY, SoC bus, GPU memory
# tracing, IRQ domains, page pool/devlink, MIPI D-PHY and DMA. Media,
# CAN, Qualcomm, MMC, virtio, RPMSG, hypervisor and balloon stay out.
# CONFIG_GKI_HACKS_TO_FIX is not set
CONFIG_GKI_NET_XFRM_HACKS=y
CONFIG_GKI_HIDDEN_CRYPTO_CONFIGS=y
CONFIG_GKI_HIDDEN_DRM_CONFIGS=y
CONFIG_GKI_HIDDEN_REGMAP_CONFIGS=y
CONFIG_GKI_HIDDEN_SND_CONFIGS=y
CONFIG_GKI_HIDDEN_SND_SOC_CONFIGS=y
CONFIG_GKI_HIDDEN_UFS_CONFIGS=y
CONFIG_GKI_HIDDEN_GPIO_CONFIGS=y
CONFIG_GKI_LEGACY_WEXT_ALLCONFIG=y
CONFIG_GKI_HIDDEN_USB_CONFIGS=y
CONFIG_GKI_HIDDEN_SOC_BUS_CONFIGS=y
CONFIG_GKI_HIDDEN_GPU_CONFIGS=y
CONFIG_GKI_HIDDEN_IRQ_CONFIGS=y
CONFIG_GKI_HIDDEN_NET_CONFIGS=y
CONFIG_GKI_HIDDEN_PHY_CONFIGS=y
CONFIG_GKI_HIDDEN_DMA_CONFIGS=y
# CONFIG_GKI_HIDDEN_MEDIA_CONFIGS is not set
# CONFIG_GKI_HIDDEN_MCP251XFD_CONFIGS is not set
# CONFIG_GKI_HIDDEN_QCOM_CONFIGS is not set
# CONFIG_GKI_HIDDEN_MMC_CONFIGS is not set
# CONFIG_GKI_HIDDEN_VIRTUAL_CONFIGS is not set
# CONFIG_GKI_HIDDEN_RPMSG_CONFIGS is not set
# CONFIG_GKI_HIDDEN_HYPERVISOR_CONFIGS is not set
# CONFIG_GKI_HIDDEN_MM_CONFIGS is not set
# CONFIG_MEDIA_SUPPORT is not set
# Only the Samsung UART exists; the DRD controller has no EHCI companion;
# there is no DisplayPort; the only PCIe device is the Wi-Fi chip on the
# Exynos 7420 root complex, with no endpoint mode.
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_SERIAL_SPRD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_DRM_EXYNOS_DP is not set
# CONFIG_PCIE_KIRIN is not set
# CONFIG_PCI_HOST_GENERIC is not set
# CONFIG_PCI_ENDPOINT is not set
# CONFIG_SCSI_UFSHCD_PCI is not set
# CONFIG_SND_PCI is not set
