# Samsung Galaxy S6 SM-G920F (zeroflte), Exynos 7420.
# Applied on top of gki_defconfig. Bring-up drivers are built in, so the
# board boots without a vendor module set.

# Core SoC
CONFIG_ARCH_EXYNOS=y
CONFIG_EXYNOS_ARM64_COMMON_CLK=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PINCTRL_EXYNOS_ARM64=y
CONFIG_EXYNOS_PMU=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_EXYNOS_PM_DOMAINS=y
CONFIG_CLKSRC_EXYNOS_MCT=y
CONFIG_EXYNOS_IOMMU=y
CONFIG_PL330_DMA=y
CONFIG_PWM_SAMSUNG=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_EXYNOS_THERMAL=y
CONFIG_EXYNOS_ADC=y
CONFIG_RTC_DRV_S3C=y

# Console
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Storage
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y

# PMIC, charger, fuel gauge
CONFIG_I2C_EXYNOS5=y
CONFIG_I2C_GPIO=y
CONFIG_MFD_SEC_CORE=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_REGULATOR_S2MPB02=y
CONFIG_MFD_MAX77843=y
CONFIG_CHARGER_MAX77843=y
CONFIG_FUEL_GAUGE_MAX77843=y

# Display
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS7_DECON=y
CONFIG_DRM_SIMPLEDRM=y

# Input
CONFIG_TOUCHSCREEN_STMFTS=y
CONFIG_KEYBOARD_CYPRESS_MBR_TOUCHKEY=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# USB
CONFIG_USB_DWC3=y
CONFIG_PHY_EXYNOS5_USBDRD=y

# PCIe (BCM4358 Wi-Fi)
CONFIG_PCI_EXYNOS7420=y

# Bring-up: plain builds without LTO, which also drops CFI.
CONFIG_LTO_NONE=y
