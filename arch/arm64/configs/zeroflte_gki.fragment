# Samsung Galaxy S6 SM-G920F (zeroflte), Exynos 7420.
# Applied on top of gki_defconfig. Bring-up drivers are built in, so the
# board boots without a vendor module set.

# Core SoC
CONFIG_ARCH_EXYNOS=y
CONFIG_EXYNOS_ARM64_COMMON_CLK=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PINCTRL_EXYNOS_ARM64=y
CONFIG_EXYNOS_PMU=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_EXYNOS_PM_DOMAINS=y
CONFIG_CLKSRC_EXYNOS_MCT=y
CONFIG_EXYNOS_IOMMU=y
CONFIG_PL330_DMA=y
CONFIG_PWM_SAMSUNG=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_EXYNOS_THERMAL=y
CONFIG_EXYNOS_ADC=y
CONFIG_RTC_DRV_S3C=y

# Console
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Storage
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y

# PMIC, charger, fuel gauge
CONFIG_I2C_EXYNOS5=y
CONFIG_I2C_GPIO=y
CONFIG_MFD_SEC_CORE=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_REGULATOR_S2MPB02=y
CONFIG_MFD_MAX77843=y
CONFIG_CHARGER_MAX77843=y
CONFIG_FUEL_GAUGE_MAX77843=y

# Display
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS7_DECON=y
CONFIG_DRM_SIMPLEDRM=y

# Input
CONFIG_TOUCHSCREEN_STMFTS=y
CONFIG_KEYBOARD_CYPRESS_MBR_TOUCHKEY=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# USB
CONFIG_USB_DWC3=y
CONFIG_PHY_EXYNOS5_USBDRD=y

# PCIe (BCM4358 Wi-Fi)
CONFIG_PCI_EXYNOS7420=y

# The Lineage 20 ramdisk in BOOT is xz-compressed; GKI only unpacks gzip,
# LZ4 and zstd.
CONFIG_RD_XZ=y

# Bring-up: faster builds without LTO (kCFI does not need it).
CONFIG_LTO_NONE=y

# S-Boot enters the kernel at EL1, so KVM can never run.
# CONFIG_KVM is not set

# Appended to S-Boot's arguments (CMDLINE_EXTEND). GKI's defaults without the
# pKVM ones, plus what the port needs: S-Boot's display clocks and power
# domains stay on, nohz=off for the per-core timer offsets S-Boot leaves.
# maxcpus=1 and permissive SELinux are for the first boot test.
CONFIG_CMDLINE="stack_depot_disable=on cgroup_disable=pressure kasan.stacktrace=off bootconfig clk_ignore_unused pd_ignore_unused deferred_probe_timeout=0 rodata=off nohz=off maxcpus=1 loglevel=8 printk.devkmsg=on androidboot.selinux=permissive"

# Size: the Image must fit the 28 MiB BOOT partition with the ROM ramdisk.
# The A57/A53 have no pointer authentication, so the PAC-to-SCS patching
# and its 3 MB of unwind tables can never be used; shadow call stacks stay,
# compiled in statically.
# CONFIG_UNWIND_PATCH_PAC_INTO_SCS is not set
# Function names stay in kallsyms; drop the data-symbol names.
# CONFIG_KALLSYMS_ALL is not set
# Keep only the codepages Android uses (UTF-8, and CP437/ISO-8859-1 for FAT).
# CONFIG_NLS_CODEPAGE_737 is not set
# CONFIG_NLS_CODEPAGE_775 is not set
# CONFIG_NLS_CODEPAGE_850 is not set
# CONFIG_NLS_CODEPAGE_852 is not set
# CONFIG_NLS_CODEPAGE_855 is not set
# CONFIG_NLS_CODEPAGE_857 is not set
# CONFIG_NLS_CODEPAGE_860 is not set
# CONFIG_NLS_CODEPAGE_861 is not set
# CONFIG_NLS_CODEPAGE_862 is not set
# CONFIG_NLS_CODEPAGE_863 is not set
# CONFIG_NLS_CODEPAGE_864 is not set
# CONFIG_NLS_CODEPAGE_865 is not set
# CONFIG_NLS_CODEPAGE_866 is not set
# CONFIG_NLS_CODEPAGE_869 is not set
# CONFIG_NLS_CODEPAGE_936 is not set
# CONFIG_NLS_CODEPAGE_950 is not set
# CONFIG_NLS_CODEPAGE_932 is not set
# CONFIG_NLS_CODEPAGE_949 is not set
# CONFIG_NLS_CODEPAGE_874 is not set
# CONFIG_NLS_ISO8859_8 is not set
# CONFIG_NLS_CODEPAGE_1250 is not set
# CONFIG_NLS_CODEPAGE_1251 is not set
# CONFIG_NLS_ISO8859_2 is not set
# CONFIG_NLS_ISO8859_3 is not set
# CONFIG_NLS_ISO8859_4 is not set
# CONFIG_NLS_ISO8859_5 is not set
# CONFIG_NLS_ISO8859_6 is not set
# CONFIG_NLS_ISO8859_7 is not set
# CONFIG_NLS_ISO8859_9 is not set
# CONFIG_NLS_ISO8859_13 is not set
# CONFIG_NLS_ISO8859_14 is not set
# CONFIG_NLS_ISO8859_15 is not set
# CONFIG_NLS_KOI8_R is not set
# CONFIG_NLS_KOI8_U is not set
# CONFIG_NLS_MAC_ROMAN is not set
# CONFIG_NLS_MAC_CELTIC is not set
# CONFIG_NLS_MAC_CENTEURO is not set
# CONFIG_NLS_MAC_CROATIAN is not set
# CONFIG_NLS_MAC_CYRILLIC is not set
# CONFIG_NLS_MAC_GAELIC is not set
# CONFIG_NLS_MAC_GREEK is not set
# CONFIG_NLS_MAC_ICELAND is not set
# CONFIG_NLS_MAC_INUIT is not set
# CONFIG_NLS_MAC_ROMANIAN is not set
# CONFIG_NLS_MAC_TURKISH is not set
# The A57/A53 have no MTE, so hardware-tag KASAN never enables itself;
# its hooks are dead code here.
# CONFIG_KASAN is not set
# CONFIG_ARM64_MTE is not set
